{
  "name": "grading-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "docker:dev": "docker compose --env-file docker/.env.local -f docker/docker-compose.dev.yml pull && docker compose --env-file docker/.env.local -f docker/docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose --env-file docker/.env.local -f docker/docker-compose.dev.yml down",
    "docker:prod": "docker compose --env-file docker/.env -f docker/docker-compose.prod.yml pull && docker compose --env-file docker/.env -f docker/docker-compose.prod.yml up -d",
    "docker:prod:down": "docker compose --env-file docker/.env -f docker/docker-compose.prod.yml down"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.2.6",
    "clsx": "^2.1.1",
    "driver.js": "^1.8.0",
    "framer-motion": "^12.39.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "respinner": "^5.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
